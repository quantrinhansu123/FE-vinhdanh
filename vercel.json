{
  "functions": {
    "api/meta-ads-sync.ts": {
      "maxDuration": 300
    },
    "api/meta-ads-leaderboard.ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/meta-ads-sync",
      "schedule": "0 * * * *"
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/" }
  ]
}

