# Supabase browser config: publishable/anon key only (never the service-role/secret key).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Upcare CRM credentials: server-only. Never add the VITE_ prefix.
UPCARE_CRM_API_BASE=https://crm.upcare.cloud
# Optional initial token/cookie. With OAuth credentials, the server logs in automatically.
UPCARE_CRM_BEARER_TOKEN=replace-me
UPCARE_CRM_COOKIE=
UPCARE_CRM_OAUTH_DB=replace-me
UPCARE_CRM_OAUTH_LOGIN=replace-me
UPCARE_CRM_OAUTH_PASSWORD=replace-me

# Public flags only; these values are safe to expose to the browser.
VITE_UPCARE_CRM_ENABLED=true
VITE_UPCARE_CRM_OAUTH_ENABLED=true

# Meta Marketing API + private Supabase writes. Set these on the server only;
# do not prefix secrets with VITE_ and never commit the actual token/key.
META_ACCESS_TOKEN=your-meta-access-token
META_AD_ACCOUNT_IDS=your-ad-account-id
META_API_VERSION=v26.0
META_REPORTING_TIMEZONE=Asia/Ho_Chi_Minh
META_SYNC_LOOKBACK_DAYS=14
META_SYNC_PAGE_SIZE=500
META_SYNC_MAX_PAGES_PER_ACCOUNT=200
CRON_SECRET=generate-a-random-secret
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-key
