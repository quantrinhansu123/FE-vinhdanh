# Upcare CRM credentials: server-only. Never add the VITE_ prefix.
UPCARE_CRM_API_BASE=https://crm.upcare.cloud
# Optional initial token/cookie. With OAuth credentials, the server logs in automatically.
UPCARE_CRM_BEARER_TOKEN=
UPCARE_CRM_COOKIE=
UPCARE_CRM_OAUTH_DB=your-database
UPCARE_CRM_OAUTH_LOGIN=your-login
UPCARE_CRM_OAUTH_PASSWORD=your-password

# Public flags only; these values are safe to expose to the browser.
VITE_UPCARE_CRM_ENABLED=true
VITE_UPCARE_CRM_OAUTH_ENABLED=true

# Public Supabase settings used by the browser app.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Meta Marketing API and private Supabase writes: server-only.
# Never prefix these secrets with VITE_ or commit actual token/key values.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_IDS=719932067032734,632847442753709,231413379347463,439223261791703,1667694257419578,3632564380338537,1396741081394607,4140666172745855,1428440365154180,1862226171366754,4041009812777827,732866852684821,1864850851104194,1883610175836979,1100085358936674,795287166904506,3846653742299007,872604782404058
META_API_VERSION=v26.0
META_REPORTING_TIMEZONE=Asia/Ho_Chi_Minh
META_SYNC_LOOKBACK_DAYS=7
META_SYNC_PAGE_SIZE=500
META_SYNC_MAX_PAGES_PER_ACCOUNT=200
# Separate random secret (32+ characters) to authorize GET/POST /api/meta-ads.
META_SYNC_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Server Auth bridge only; falls back to the public anon key above.
SUPABASE_ANON_KEY=
# Optional signed CRM cookie key; falls back to META_SYNC_SECRET if unset.
CRM_SESSION_SECRET=
CRON_SECRET=
# Number of prior Vietnam-local days to refresh in addition to today (1-6).
MARKETING_SYNC_LOOKBACK_DAYS=3
MARKETING_SYNC_ALLOW_LOCAL=false
META_APP_ID=
