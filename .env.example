# Upcare CRM credentials: server-only. Never add the VITE_ prefix.
UPCARE_CRM_API_BASE=https://crm.upcare.cloud
# Optional initial token/cookie. With OAuth credentials, the server logs in automatically.
UPCARE_CRM_BEARER_TOKEN=
UPCARE_CRM_COOKIE=
UPCARE_CRM_OAUTH_DB=your-database
UPCARE_CRM_OAUTH_LOGIN=your-login
UPCARE_CRM_OAUTH_PASSWORD=your-password

# Public flags only; these values are safe to expose to the browser.
VITE_UPCARE_CRM_ENABLED=true
VITE_UPCARE_CRM_OAUTH_ENABLED=true

# Public Supabase settings used by the browser app.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Meta Marketing API and private Supabase writes: server-only.
# Never prefix these secrets with VITE_ or commit actual token/key values.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_IDS=1403117645112746,4138174149811846,2077138936251119,439223261791703,1667694257419578,795287166904506,872604782404058,3846653742299007,3580301642125509,3024448981242719,2100366800598176,1111863964935586,1643112206313001,1000185126456353,1002931269547788,1804253930488901,1838075144002580,1110796096658322,2895622560812930,2224702628443401,2029855044346617,1669837528200615,4140666172745855,3632564380338537,231413379347463,719932067032734,1428440365154180,1396741081394607,1100085358936674,1864850851104194,1883610175836979,632847442753709,1598069334890647,1338875958163968,732866852684821,1862226171366754,24349249114765574,4041009812777827
